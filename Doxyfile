#---------------------------------------------------------------------------
# Doxyfile for mcp-agent-runtime
# MCP Agent Runtime - C++20 MCP Server/Client with RAG-MCP
#---------------------------------------------------------------------------

# ======================== 项目基本信息 ========================
PROJECT_NAME           = "MCP Agent Runtime"
PROJECT_NUMBER         = "0.7.0"
PROJECT_BRIEF          = "A C++20 implementation of Model Context Protocol (MCP) with RAG-enhanced tool selection"
OUTPUT_DIRECTORY       = docs/doxygen_output

# ======================== 输入配置 ========================
INPUT                  = mcp_server/include \
                         mcp_server/src \
                         mcp_server/plugins \
                         mcp_client/include \
                         mcp_client/src \
                         common/include \
                         common/src \
                         examples \
                         README.md
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = third_party \
                         build \
                         docs/doxygen_output \
                         tests
EXCLUDE_PATTERNS       = */third_party/* */build/*

# ======================== 提取配置 ========================
# 项目源码注释较少，开启 EXTRACT_ALL 让 Doxygen 提取所有符号
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

# ======================== 构建配置 ========================
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
INCLUDE_PATH           = mcp_server/include \
                         mcp_client/include \
                         common/include \
                         third_party

# 忽略第三方头文件的警告
EXCLUDE_SYMBOLS        = nlohmann \
                         httplib \
                         aixlog \
                         popl \
                         base64

# ======================== Graphviz/Dot 图表配置 ========================
HAVE_DOT               = YES
DOT_PATH               =
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100

# 类继承关系图
CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INHERITANCE_GRAPHS     = YES

# 函数调用关系图
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# 头文件包含依赖图
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

# 目录依赖图
DIRECTORY_GRAPH        = YES
DIR_GRAPH_MAX_DEPTH    = 3

# ======================== 输出格式 ========================
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

HTML_OUTPUT            = html
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
SEARCHENGINE           = YES
TREEVIEW               = YES

# ======================== 源码浏览 ========================
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ======================== 其他配置 ========================
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES

DOT_NUM_THREADS        = 4
NUM_PROC_THREADS       = 4
